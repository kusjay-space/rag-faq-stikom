# Ambil API key di https://aistudio.google.com/apikey lalu tempel di bawah ini
GEMINI_API_KEY=masukkan-api-key-gemini-anda
MODEL_EMBED=gemini-embedding-001
MODEL_LLM=gemini-3.1-flash-lite
EMBED_DIM=768
DOCS_DIR=data/docs-kurikulum
SIMILARITY_THRESHOLD=0.60
TOP_K=8

# Wajib. Password lokal saja; jangan pakai kredensial produksi.
DATABASE_URL=postgresql://rag_app:GANTI-PASSWORD-INI@127.0.0.1:5432/rag_kurikulum
# Jeda antar batch 80 teks saat ingest (detik). 0 = tanpa jeda (uji lokal).
INGEST_JEDA_DETIK=65

# Kosongkan LLM_BASE_URL untuk memakai Gemini langsung; isi untuk lewat gateway OpenAI-compatible.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

