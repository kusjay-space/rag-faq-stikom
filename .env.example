# Ambil API key di https://aistudio.google.com/apikey lalu tempel di bawah ini
GEMINI_API_KEY=masukkan-api-key-gemini-anda
EMBED_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
EMBED_DIM=768
DOCS_DIR=data/docs-kurikulum
SIMILARITY_THRESHOLD=0.60
TOP_K=8

# Wajib. Password lokal saja; jangan pakai kredensial produksi.
DATABASE_URL=postgresql://rag_app:GANTI-PASSWORD-INI@127.0.0.1:5432/rag_kurikulum
# Jeda antar batch 80 teks saat ingest (detik). 0 = tanpa jeda (uji lokal).
INGEST_JEDA_DETIK=65

# Kosongkan LLM_BASE_URL untuk memakai Gemini langsung; isi untuk lewat gateway OpenAI-compatible.
LLM_BASE_URL=http://openai/v1
LLM_API_KEY=masukkan-api-key
LLM_MODEL=tokenharbor/deepseek-v4-flash:free

# Koneksi khusus evaluasi (role rag_eval). Terpisah dari DATABASE_URL supaya aplikasi
# tidak punya hak menulis schema eval. Isi password-nya di .env, jangan di berkas ini.
EVAL_DATABASE_URL=postgresql://rag_eval:***@127.0.0.1:5432/rag_kurikulum
# Embedding untuk metrik RAGAS (lokal/offline lewat fastembed, tanpa kuota API)
EVAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Penilai RAGAS lewat gateway 9router (jangan pakai Gemini). Kosong = penilaian dimatikan.
EVAL_JUDGE_BASE_URL=http://openai/v1
EVAL_JUDGE_MODEL=tokenharbor/deepseek-v4-flash:free
